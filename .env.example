# Copy this file to .env and fill in real values. Never commit the real .env file.

# Port for local development only — Render sets this automatically in production
PORT=

# Supabase project (Settings → API in your Supabase dashboard)
SUPABASE_URL= 
SUPABASE_ANON_KEY= 
# Shared secret the cron job must send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Deployed frontend origin, used for CORS (e.g. https://your-app.vercel.app)
FRONTEND_URL=

# Base URL of the mock store being scraped
TARGET_STORE_URL=
